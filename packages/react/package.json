{
  "name": "@glyphy/react",
  "version": "0.1.0",
  "description": "React bindings for the Glyphy nine-cell glyph UI kit — <Glyph>, <GlyphProvider> and headless hooks.",
  "keywords": [
    "glyph",
    "react",
    "animation",
    "ui-kit",
    "spinner",
    "loader"
  ],
  "license": "MIT",
  "author": "The Glyphy authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/glyphy.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/your-org/glyphy/issues"
  },
  "homepage": "https://github.com/your-org/glyphy/tree/master/packages/react#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "publint": "publint"
  },
  "dependencies": {
    "@glyphy/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
