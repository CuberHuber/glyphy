{
  "name": "@glyphy/core",
  "version": "0.1.0",
  "description": "Framework-agnostic engine for the Glyphy nine-cell glyph: geometry, motion frames and fill patterns. Zero dependencies.",
  "keywords": [
    "glyph",
    "animation",
    "ui-kit",
    "headless",
    "spinner"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "CuberHuber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuberHuber/glyphy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/CuberHuber/glyphy/issues"
  },
  "homepage": "https://github.com/CuberHuber/glyphy/tree/main/packages/core#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "publint": "publint"
  }
}
