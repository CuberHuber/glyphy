# Every file has an owner. A pull request without a review from one does not merge.
#
# This is a personal account, so the owner is a person. If the project ever
# moves to an organisation, replace @CuberHuber with @<org>/maintainers here and
# the review requirement spreads across the team without touching anything else.
*                       @CuberHuber

# The engine is where a careless change is invisible until it ships, so it
# carries its own reviewers.
/packages/core/         @CuberHuber
/packages/react/        @CuberHuber
/packages/motion/       @CuberHuber
/packages/tailwind/     @CuberHuber

# Changing a gate is changing the project's standards, not its code.
/.github/workflows/     @CuberHuber
/eslint.config.js       @CuberHuber
/vitest.config.ts       @CuberHuber
/.rultor.yml            @CuberHuber

# The handoff bundle is a historical record. It is read, not edited.
/design/                @CuberHuber
